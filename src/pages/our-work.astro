---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Testimonials from '../components/Testimonials.astro';
import { getSettings } from '../lib/settings';

// Client projects appear only when switched on AND the author gave permission.
const all = (await getCollection('work', ({ data }) => data.published && data.showOnWork
  && (data.projectFor !== 'Client' || data.permission)))
  .sort((a, b) => a.data.order - b.data.order);
const featured = all.find((p) => p.data.featured);
const rest = all.filter((p) => p !== featured);
const types = [...new Set(rest.map((p) => p.data.type))];
const { startHref } = await getSettings();
const f = featured?.data;
---
<Base title="Our Work | EION Books" description="Publishing and design work EION Books has done for independent authors.">
  <section class="hero">
    <div class="wrap hero__row">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow">OUR WORK</p>
        <h1 class="display caps hero__title">Their books. <span>Our support.</span></h1>
      </div>
      <div class="hero__note">
        <p>Every book here was published by its author, through their own accounts. Each project lists exactly what EION did.</p>
      </div>
    </div>
  </section>

  <section class="wrap key">
    <p><span class="badge badge--client">AUTHOR-PUBLISHED</span> Book published by the author, with EION Publishing Services</p>
    <p><span class="badge badge--studio">CREATIVE STUDIO</span> Design work for an author</p>
    <p class="key__books">Looking for EION's own titles? <a href="/our-books/">Our Books &rarr;</a></p>
  </section>

  {f && (
    <section class="wrap feature-wrap">
      <article class="feature reveal">
        <div class="feature__shot"><img class="lift" src={f.image} alt={f.imageAlt} /></div>
        <div class="feature__copy">
          <span class:list={['badge', f.type === 'Creative Studio' ? 'badge--studio' : 'badge--client']}>FEATURED PROJECT · {f.service.toUpperCase()}</span>
          <h2 class="display feature__title">{f.title}</h2>
          <p class="feature__meta">{f.service} for {f.client}{f.bookType && ` · ${f.bookType}`}</p>
          <dl>
            <dt>THE PROJECT</dt><dd>{f.summary}</dd>
            {f.whatWeDid && <><dt>WHAT EION DID</dt><dd>{f.whatWeDid}</dd></>}
          </dl>
          {f.quote && (
            <blockquote class="feature__quote">
              <p>&ldquo;{f.quote}&rdquo;</p>
              {f.quoteBy && <cite>{f.quoteBy}</cite>}
            </blockquote>
          )}
          {f.link && <a class="btn btn--dark" href={f.link}>{f.linkLabel} &rarr;</a>}
        </div>
      </article>
    </section>
  )}

  <section class="wrap shelf">
    <div class="shelf__head">
      <h2 class="display shelf__title">All projects</h2>
      {types.length > 1 && (
        <div class="filters" role="group" aria-label="Filter projects">
          <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">All</button>
          {types.map((t) => (
            <button type="button" class="filter" data-filter={t} aria-pressed="false">{t === 'Author-published' ? 'Publishing' : t}</button>
          ))}
        </div>
      )}
    </div>
    <div class="grid">
      {rest.map((project) => <WorkCard project={project} />)}
    </div>
    <p class="shelf__note">Projects appear only with the author's written permission. Links go to the author's own sites and listings.</p>
  </section>

  <section class="wrap studio-strip">
    <p><strong>Looking for custom websites?</strong> See the storefronts, multi-page sites, and landing pages built by EION Creative Studio.</p>
    <a class="btn btn--dark" href="/creative-studio/#portfolio">See the websites we've built &rarr;</a>
  </section>

  <Testimonials />

  <section class="band">
    <div class="wrap band__row">
      <p class="display band__title">Your book could be <span>next.</span></p>
      <a href={startHref} class="btn btn--dark">Start Your Project &rarr;</a>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('.grid .work');
  buttons.forEach((btn) => btn.addEventListener('click', () => {
    const f = btn.dataset.filter;
    buttons.forEach((b) => { const on = b === btn; b.classList.toggle('is-active', on); b.setAttribute('aria-pressed', String(on)); });
    cards.forEach((c) => { c.hidden = !(f === 'all' || c.dataset.type === f); });
  }));
</script>

<style>
  .hero { background: var(--aubergine); color: var(--cream); }
  .hero__row { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-end; justify-content: space-between; padding-block: 90px 96px; }
  .hero__copy { flex: 1 1 560px; }
  .hero__eyebrow { color: var(--marigold); }
  .hero__title { margin: 0; font-size: clamp(56px, 7vw, 108px); line-height: 0.86; }
  .hero__title span { color: var(--marigold); }
  .hero__note { flex: 0 1 420px; border-left: 3px solid var(--marigold); padding-left: 22px; }
  .hero__note p { margin: 0; color: var(--on-dark); }

  .key { display: flex; flex-wrap: wrap; gap: 14px 36px; align-items: center; padding-block: 36px; border-bottom: 1px solid var(--line); font-size: 15px; color: var(--ink-soft); }
  .key p { margin: 0; display: flex; align-items: center; gap: 10px; }
  .key__books { margin-left: auto !important; }
  .key__books a { font-weight: 700; margin-left: 4px; }

  .feature-wrap { padding-block: 90px 90px; }
  .feature { display: flex; flex-wrap: wrap; gap: 56px; align-items: center; background: var(--sand); border-radius: 16px; padding: 56px; }
  .feature__shot { flex: 1 1 420px; }
  .feature__shot img { width: 100%; border-radius: 10px; box-shadow: 0 34px 60px -30px rgba(42,20,51,0.6); }
  .feature__copy { flex: 1 1 400px; min-width: 0; }
  .feature__title { margin: 16px 0 6px; font-size: 64px; line-height: 0.9; }
  .feature__meta { margin: 0 0 22px; color: var(--ink-soft); font-weight: 600; }
  dl { margin: 0; }
  dt { font-size: 12px; font-weight: 700; letter-spacing: 0.18em; color: var(--teal); margin-top: 14px; }
  dd { margin: 4px 0 0; color: var(--ink-soft); }
  .feature__quote { margin: 26px 0 26px; border-left: 3px solid var(--marigold); padding-left: 18px; }
  .feature__quote p { margin: 0; font-size: 19px; font-weight: 600; }
  .feature__quote cite { display: block; margin-top: 6px; font-style: normal; font-size: 15px; color: var(--mauve); }

  .shelf { padding-bottom: 110px; }
  .shelf__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 40px; }
  .shelf__title { margin: 0; font-size: 56px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter { border: 1.5px solid var(--aubergine); background: transparent; color: var(--aubergine); padding: 10px 18px; border-radius: 999px; font: inherit; font-size: 15px; font-weight: 700; cursor: pointer; min-height: 44px; }
  .filter.is-active { background: var(--aubergine); color: var(--cream); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px 36px; }
  .shelf__note { margin: 48px 0 0; font-size: 14px; color: var(--mauve); }

  .studio-strip { display: flex; flex-wrap: wrap; gap: 20px 32px; align-items: center; justify-content: space-between; margin-bottom: 110px; padding: 32px 36px; border-radius: 14px; background: var(--sand); border-left: 6px solid var(--teal); }
  .studio-strip p { margin: 0; flex: 1 1 420px; color: var(--ink-soft); }
  .studio-strip strong { color: var(--aubergine); }
  .band { background: var(--marigold); }
  .band__row { display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between; padding-block: 90px; }
  .band__title { margin: 0; font-size: 56px; line-height: 0.95; }
  .band__title span { color: var(--teal); }

  @media (max-width: 640px) {
    .hero__row { padding-block: 56px 60px; }
    .key__books { margin-left: 0 !important; }
    .feature-wrap { padding-block: 48px; }
    .feature { padding: 26px; gap: 26px; }
    .feature__title { font-size: 44px; }
    .shelf__title, .band__title { font-size: 40px; }
  }
</style>
