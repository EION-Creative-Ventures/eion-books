---
import { getEntry, getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getSettings } from '../lib/settings';
import { getBookAuthorLinks } from '../lib/authors';

const entry = await getEntry('publishing', 'publishing-services');
if (!entry) throw new Error('Publishing Services content is missing (src/content/pages/publishing-services.yaml).');
const c = entry.data;
const { startHref } = await getSettings();
// Only books switched on with "Show on Publishing Services" appear here.
const books = (await getCollection('books', ({ data }) => data.published && data.showOnPublishing))
  .sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const authorLinks = await getBookAuthorLinks();
---
<Base title="Publishing Services | EION Books" description={c.heroIntro}>
  <section class="hero">
    <div class="wrap hero__row">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow">{c.heroEyebrow}</p>
        <h1 class="display caps hero__title">{c.heroTitle}{c.heroAccent && <><br /><span>{c.heroAccent}</span></>}</h1>
      </div>
      <div class="hero__side">
        <p>{c.heroIntro}</p>
        <a class="btn btn--marigold" href={startHref}>{c.heroButton} &rarr;</a>
      </div>
    </div>
  </section>

  <section class="wrap model">
    <div class="model__copy">
      <p class="eyebrow model__eyebrow">{c.modelEyebrow}</p>
      <h2 class="display model__title">{c.modelHeading}</h2>
      <p class="model__text">{c.modelText}</p>
    </div>
    <div class="model__wrap">
      <div class="model__table reveal">
        <div class="model__col">
          <h3 class="model__head model__keep">{c.youKeepLabel}</h3>
          <ul>{c.youKeep.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="model__col">
          <h3 class="model__head model__give">{c.weProvideLabel}</h3>
          <ul>{c.weProvide.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
      {c.modelNote && <p class="model__note">{c.modelNote}</p>}
    </div>
  </section>

  <section class="phases">
    <div class="wrap">
      <p class="eyebrow phases__eyebrow">{c.phasesEyebrow}</p>
      <h2 class="display phases__title">{c.phasesHeading}</h2>
      <ol class="phases__grid">
        {c.phases.map((ph, i) => (
          <li class="phase reveal">
            <span class="display phase__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{ph.title}</h3>
            <ul>{ph.items.map((it) => <li>{it}</li>)}</ul>
          </li>
        ))}
      </ol>
      {c.phasesNote && <p class="phases__note">{c.phasesNote}</p>}
    </div>
  </section>

  <section class="wrap ways">
    <p class="eyebrow ways__eyebrow">{c.waysEyebrow}</p>
    <h2 class="display ways__title">{c.waysHeading}</h2>
    <div class="ways__grid">
      {c.ways.map((w) => (
        <article class:list={['way reveal', { 'way--hi': !!w.highlight }]}>
          {w.highlight && <span class="way__flag">{w.highlight}</span>}
          <h3 class="display">{w.title}</h3>
          <p>{w.text}</p>
          <a href={startHref}>{w.linkText} &rarr;</a>
        </article>
      ))}
    </div>
    {c.waysNote && <p class="ways__note">{c.waysNote}</p>}
  </section>

  {books.length > 0 && (
    <section class="books">
      <div class="wrap books__row">
        <div class="books__intro">
          <p class="eyebrow books__eyebrow">{c.booksEyebrow}</p>
          <h2 class="display books__title">{c.booksHeading}</h2>
          {c.booksText && <p class="books__text">{c.booksText}</p>}
          {c.booksLinkText && <a class="btn btn--dark" href="/our-books/">{c.booksLinkText} &rarr;</a>}
        </div>
        <ul class="books__list">
          {books.map((b) => {
            const al = authorLinks.get(b.id);
            return (
              <li class="fbook reveal">
                <div class="fbook__frame"><img src={b.data.cover} alt={b.data.coverAlt} loading="lazy" /></div>
                {b.data.projectLabel && <span class="fbook__label">{b.data.projectLabel.toUpperCase()}</span>}
                <h3>{b.data.title}</h3>
                <p>by {al ? <a href={al.href}>{b.data.author}</a> : b.data.author}</p>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="wrap faq">
    <div class="faq__head">
      <p class="eyebrow faq__eyebrow">{c.faqEyebrow}</p>
      <h2 class="display faq__title">{c.faqHeading}</h2>
    </div>
    <div class="faq__list">
      {c.faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.question}<span aria-hidden="true"></span></summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="close">
    <div class="wrap close__row">
      <p class="display close__title">{c.closingHeading}</p>
      <a class="btn btn--dark" href={startHref}>{c.closingButton} &rarr;</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--aubergine); color: var(--cream); }
  .hero__row { display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-end; justify-content: space-between; padding-block: 100px 110px; }
  .hero__copy { flex: 1 1 640px; min-width: 0; }
  .hero__eyebrow { color: var(--coral); }
  .hero__title { margin: 0; font-size: clamp(56px, 7vw, 104px); line-height: 0.88; }
  .hero__title span { color: var(--marigold); }
  .hero__side { flex: 0 1 400px; }
  .hero__side p { margin: 0 0 26px; font-size: 19px; color: var(--on-dark); }

  .model { display: flex; flex-wrap: wrap; gap: 64px; padding-block: 130px 110px; }
  .model__copy { flex: 1 1 380px; min-width: 0; }
  .model__eyebrow { color: var(--coral); }
  .model__title { margin: 0; font-size: clamp(40px, 4.4vw, 64px); line-height: 0.95; }
  .model__text { margin: 24px 0 0; color: var(--ink-soft); }
  .model__wrap { flex: 1.3 1 520px; min-width: 0; }
  .model__table { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1.5px solid var(--aubergine); border-radius: 12px; overflow: hidden; }
  .model__col + .model__col { border-left: 1px solid var(--line); }
  .model__head { margin: 0; padding: 20px 26px; font-family: var(--display); font-weight: 800; font-stretch: 75%; font-size: 26px; }
  .model__keep { background: var(--marigold); }
  .model__give { background: var(--aubergine); color: var(--cream); }
  .model__col ul { margin: 0; padding: 0; list-style: none; }
  .model__col li { padding: 16px 26px; border-top: 1px solid var(--line); }
  .model__col li:first-child { border-top: 0; }
  .model__note { margin: 14px 0 0; font-size: 15px; color: var(--mauve); }

  .phases { background: var(--sand); padding-block: 120px; }
  .phases__eyebrow { color: var(--teal); }
  .phases__title { margin: 0 0 56px; max-width: 860px; font-size: clamp(40px, 4.6vw, 68px); line-height: 0.95; }
  .phases__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .phase { background: var(--paper); border-radius: 12px; padding: 30px 28px; border-top: 6px solid var(--aubergine); }
  .phase:nth-child(2) { border-top-color: var(--teal); }
  .phase:nth-child(3) { border-top-color: var(--coral); }
  .phase:nth-child(4) { border-top-color: var(--marigold); }
  .phase__num { font-size: 48px; color: var(--mauve); }
  .phase h3 { margin: 10px 0 14px; font-size: 24px; }
  .phase ul { margin: 0; padding: 0; list-style: none; }
  .phase li { padding: 10px 0; border-top: 1px solid var(--line); font-size: 16px; }
  .phases__note { margin: 32px 0 0; padding: 18px 24px; border-radius: 10px; background: var(--aubergine); color: var(--cream); font-weight: 600; }

  .ways { padding-block: 130px 110px; }
  .ways__eyebrow { color: var(--coral); }
  .ways__title { margin: 0 0 48px; font-size: clamp(40px, 4.6vw, 68px); line-height: 0.95; }
  .ways__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .way { position: relative; display: flex; flex-direction: column; gap: 14px; padding: 36px 32px; border: 1.5px solid var(--aubergine); border-radius: 12px; background: var(--paper); }
  .way h3 { margin: 0; font-size: 34px; line-height: 0.95; }
  .way p { margin: 0; color: var(--ink-soft); }
  .way a { margin-top: auto; padding-top: 8px; font-weight: 700; }
  .way--hi { background: var(--marigold); border-color: var(--marigold); }
  .way--hi p { color: var(--aubergine); }
  .way__flag { align-self: flex-start; background: var(--aubergine); color: var(--cream); padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; }
  .ways__note { margin: 28px 0 0; color: var(--mauve); font-size: 15px; }

  .books { background: var(--paper); padding-block: 100px; border-block: 1px solid var(--line); }
  .books__row { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: 56px; align-items: center; }
  .books__eyebrow { color: var(--coral); }
  .books__title { margin: 0; font-size: clamp(38px, 4.2vw, 58px); line-height: 0.95; }
  .books__text { margin: 18px 0 28px; color: var(--ink-soft); }
  .books__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .fbook__frame { aspect-ratio: 1; background: var(--cover-bg); border-radius: 10px; display: flex; align-items: center; justify-content: center; }
  .fbook__frame img { max-width: 80%; max-height: 84%; border-radius: 2px 5px 5px 2px; box-shadow: 0 20px 34px -16px rgba(42,20,51,0.5); }
  .fbook__label { display: inline-block; margin-top: 16px; padding: 4px 10px; border-radius: 4px; background: var(--teal); color: var(--cream); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; }
  .fbook h3 { margin: 10px 0 2px; font-size: 18px; line-height: 1.3; }
  .fbook p { margin: 0; font-size: 15px; color: var(--mauve); }
  .fbook p a { color: inherit; font-weight: 600; }

  .faq { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 64px; padding-block: 130px 120px; }
  .faq__eyebrow { color: var(--teal); }
  .faq__title { margin: 0; font-size: clamp(40px, 4.6vw, 64px); line-height: 0.95; }
  details { border-top: 1.5px solid var(--aubergine); }
  details:last-child { border-bottom: 1.5px solid var(--aubergine); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 0; font-weight: 700; font-size: 20px; }
  summary::-webkit-details-marker { display: none; }
  summary span { flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--marigold); position: relative; }
  summary span::before, summary span::after { content: ""; position: absolute; left: 50%; top: 50%; width: 14px; height: 2px; background: var(--aubergine); transform: translate(-50%, -50%); }
  summary span::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] summary span::after { display: none; }
  summary:focus-visible { outline: 3px solid var(--marigold); outline-offset: 4px; }
  details p { margin: 0 0 24px; max-width: 640px; color: var(--ink-soft); }

  .close { background: var(--coral); }
  .close__row { display: flex; flex-wrap: wrap; gap: 28px; align-items: center; justify-content: space-between; padding-block: 90px; }
  .close__title { margin: 0; font-size: clamp(44px, 5vw, 68px); line-height: 0.95; }

  @media (max-width: 1000px) {
    .phases__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ways__grid { grid-template-columns: 1fr; }
    .books__row { grid-template-columns: 1fr; gap: 36px; }
    .faq { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 640px) {
    .hero__row { padding-block: 56px 64px; gap: 28px; }
    .model, .ways, .faq { padding-block: 64px; }
    .phases, .books { padding-block: 64px; }
    .phases__grid { grid-template-columns: 1fr; }
    .model__table { grid-template-columns: 1fr; }
    .model__col + .model__col { border-left: 0; border-top: 1.5px solid var(--aubergine); }
    .model__col li { padding: 14px 20px; }
    .books__list { gap: 14px; }
    .fbook h3 { font-size: 15px; }
    .fbook p { font-size: 13px; }
    .fbook__label { font-size: 9px; padding: 3px 6px; letter-spacing: 0.08em; }
    summary { font-size: 18px; }
  }
</style>
