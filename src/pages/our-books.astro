---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookCard from '../components/BookCard.astro';

const all = (await getCollection('books', ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);
const featured = all.find((b) => b.data.featured);
const rest = all.filter((b) => b !== featured);
const categories = [...new Set(rest.map((b) => b.data.category))];
---
<Base title="Our Books | EION Books" description="Books published under the EION Books imprint.">
  <section class="hero">
    <div class="wrap hero__row">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow">OUR BOOKS</p>
        <h1 class="display caps hero__title">Published by <span>EION Books.</span></h1>
      </div>
      <div class="hero__note">
        <p>These titles carry the EION Books imprint. Looking for books authors published with our help? <a href="#">See Our Work</a>.</p>
      </div>
    </div>
  </section>

  {featured && (
    <section class="wrap feature-wrap">
      <article class="feature reveal">
        <div class="feature__cover"><img class="lift" src={featured.data.cover} alt={featured.data.coverAlt} /></div>
        <div class="feature__copy">
          <span class="badge badge--imprint">EION IMPRINT · {featured.data.category.toUpperCase()}</span>
          <h2 class="display feature__title">{featured.data.title}</h2>
          {featured.data.subtitle && <p class="feature__subtitle">{featured.data.subtitle}</p>}
          <p class="feature__meta">by {featured.data.author}</p>
          <p class="feature__meta">{featured.data.description}</p>
          {featured.data.buyUrl && <a class="btn btn--dark" href={featured.data.buyUrl}>{featured.data.buyLabel} &rarr;</a>}
        </div>
      </article>
    </section>
  )}

  <section class="wrap shelf">
    <div class="shelf__head">
      <div>
        <p class="shelf__kicker">THE PEYTON'S JOURNEY SERIES &amp; MORE PICTURE BOOKS</p>
        <h2 class="display shelf__title">Picture books</h2>
      </div>
      <div class="filters" role="group" aria-label="Filter books">
        <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">All</button>
        {categories.map((c) => (
          <button type="button" class="filter" data-filter={c} aria-pressed="false">{c}</button>
        ))}
      </div>
    </div>
    <div class="grid">
      {rest.map((book) => <BookCard book={book} />)}
    </div>
  </section>

  <section class="band">
    <div class="wrap band__row">
      <div>
        <p class="display band__title">We publish on the same platforms you'll use.</p>
        <p class="band__sub">Bring that experience to your own book.</p>
      </div>
      <a href="#" class="btn btn--dark">Explore Publishing Services &rarr;</a>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('.grid .book');
  buttons.forEach((btn) => btn.addEventListener('click', () => {
    const f = btn.dataset.filter;
    buttons.forEach((b) => { const on = b === btn; b.classList.toggle('is-active', on); b.setAttribute('aria-pressed', String(on)); });
    cards.forEach((c) => { c.hidden = !(f === 'all' || c.dataset.category === f); });
  }));
</script>

<style>
  .hero { background: var(--aubergine); color: var(--cream); }
  .hero__row { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-end; justify-content: space-between; padding-block: 90px 96px; }
  .hero__copy { flex: 1 1 560px; }
  .hero__eyebrow { color: var(--marigold); }
  .hero__title { margin: 0; font-size: clamp(56px, 7vw, 108px); line-height: 0.86; }
  .hero__title span { color: var(--marigold); }
  .hero__note { flex: 0 1 420px; border-left: 3px solid var(--marigold); padding-left: 22px; }
  .hero__note p { margin: 0; color: var(--on-dark); }
  .hero__note a { color: var(--marigold); font-weight: 700; }

  .feature-wrap { padding-block: 110px 90px; }
  .feature { display: flex; flex-wrap: wrap; gap: 64px; align-items: center; background: var(--sand); border-radius: 16px; padding: 64px; }
  .feature__cover { flex: 0 1 300px; display: flex; justify-content: center; }
  .feature__cover img { width: 100%; max-width: 280px; box-shadow: 0 34px 60px -26px rgba(42,20,51,0.6); }
  .feature__copy { flex: 1 1 440px; min-width: 0; }
  .feature__title { margin: 16px 0 6px; font-size: 64px; line-height: 0.9; }
  .feature__subtitle { margin: 0 0 20px; font-size: 21px; font-weight: 600; }
  .feature__meta { margin: 0 0 8px; color: var(--ink-soft); }
  .feature__copy .btn { margin-top: 20px; }

  .shelf { padding-bottom: 130px; }
  .shelf__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 40px; }
  .shelf__kicker { margin: 0 0 12px; font-weight: 700; font-size: 13px; letter-spacing: 0.18em; }
  .shelf__title { margin: 0; font-size: 56px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter { border: 1.5px solid var(--aubergine); background: transparent; color: var(--aubergine); padding: 10px 18px; border-radius: 999px; font: inherit; font-size: 15px; font-weight: 700; cursor: pointer; min-height: 44px; }
  .filter.is-active { background: var(--aubergine); color: var(--cream); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 36px; }

  .band { background: var(--marigold); }
  .band__row { display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between; padding-block: 90px; }
  .band__title { margin: 0; font-size: 48px; line-height: 0.95; }
  .band__sub { margin: 12px 0 0; font-weight: 500; }

  @media (max-width: 640px) {
    .feature { padding: 28px; gap: 28px; }
    .feature__title { font-size: 44px; }
    .shelf__title, .band__title { font-size: 40px; }
    .hero__row { padding-block: 56px 60px; }
    .feature-wrap { padding-block: 56px; }
  }
</style>
