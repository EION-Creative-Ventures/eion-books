---
// Shared site footer (Bold Spine). Text and links come from Site settings in the dashboard.
import { getSettings } from '../lib/settings';
const s = await getSettings();
const social = [
  { label: 'Instagram', href: s.instagramUrl },
  { label: 'LinkedIn', href: s.linkedinUrl },
  { label: 'Facebook', href: s.facebookUrl },
].filter((l) => l.href);
---
<footer class="footer">
  <div class="footer__stripe" aria-hidden="true">
    <span style="flex:3;background:var(--marigold)"></span><span style="flex:2;background:var(--coral)"></span><span style="flex:4;background:var(--teal)"></span><span style="flex:1;background:var(--cream)"></span><span style="flex:2;background:var(--marigold)"></span>
  </div>
  <div class="wrap footer__row">
    <div class="footer__brand">
      <p class="display footer__name">EION BOOKS</p>
      {s.footerTagline && <p class="footer__line">{s.footerTagline}</p>}
      {s.footerBlurb && <p class="footer__blurb">{s.footerBlurb}</p>}
    </div>
    <nav aria-label="Footer" class="footer__nav">
      <div><span>SERVICES</span><a href="#">Publishing Services</a><a href="/creative-studio/">Creative Studio</a><a href={s.startHref}>Start Your Project</a></div>
      <div><span>BOOKS</span><a href="/our-books/">Our Books</a><a href="/meet-our-authors/">Meet Our Authors</a><a href="/our-work/">Our Work</a><a href="/about/">About</a></div>
      {(s.contactEmail || social.length > 0 || s.privacyUrl) && <div><span>CONNECT</span>{s.contactEmail && <a href={`mailto:${s.contactEmail}`}>{s.contactEmail}</a>}{social.map((l) => <a href={l.href}>{l.label}</a>)}{s.privacyUrl && <a href={s.privacyUrl}>Privacy Policy</a>}</div>}
    </nav>
  </div>
  <div class="wrap footer__legal">&copy; EION Books, a brand of EION Creative Ventures, LLC</div>
</footer>

<style>
  .footer { background: var(--aubergine-deep); color: var(--on-dark); font-size: 15px; }
  .footer__stripe { display: flex; height: 8px; }
  .footer__row { display: flex; flex-wrap: wrap; gap: 48px; justify-content: space-between; padding-block: 72px 40px; }
  .footer__brand { flex: 1 1 320px; }
  .footer__name { margin: 0; font-size: 44px; color: var(--cream); }
  .footer__line { margin: 14px 0 0; font-weight: 700; color: var(--marigold); }
  .footer__blurb { margin: 18px 0 0; max-width: 340px; color: var(--on-dark-quiet); }
  .footer__nav { display: flex; flex-wrap: wrap; gap: 64px; }
  .footer__nav div { display: flex; flex-direction: column; gap: 12px; }
  .footer__nav span { font-family: var(--display); font-weight: 700; font-size: 12px; letter-spacing: 0.18em; color: var(--marigold); }
  .footer__nav a { color: var(--on-dark); text-decoration: none; }
  .footer__nav a:hover { color: var(--cream); text-decoration: underline; }
  .footer__legal { padding-block: 22px 36px; border-top: 1px solid rgba(255,246,233,0.12); font-size: 13px; color: var(--on-dark-quiet); }
</style>
