---
// "What authors say" — testimonials from the dashboard.
import { getCollection } from 'astro:content';
interface Props { heading?: string }
const { heading = 'What authors say' } = Astro.props;
const items = (await getCollection('testimonials', ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);
const initials = (n: string) => n.replace(/^Dr\.?\s+/i, '').split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---
{items.length > 0 && (
  <section class="tm">
    <div class="wrap">
      <p class="eyebrow tm__eyebrow">{heading.toUpperCase()}</p>
      <div class="tm__grid">
        {items.map(({ data: t }) => (
          <figure class="tm__card reveal">
            <span class="tm__mark" aria-hidden="true">&ldquo;</span>
            <blockquote>{t.quote}</blockquote>
            <figcaption>
              {t.photo
                ? <img src={t.photo} alt={t.photoAlt || t.name} loading="lazy" />
                : <span class="tm__initials" aria-hidden="true">{initials(t.name)}</span>}
              <span><strong>{t.name}</strong>{t.role && <span class="tm__role">{t.role}</span>}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .tm { background: var(--teal); color: var(--cream); padding-block: 110px; }
  .tm__eyebrow { color: var(--cream); --bar: var(--marigold); }
  .tm__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 28px; }
  .tm__card { margin: 0; background: var(--cream); color: var(--aubergine); border-top: 6px solid var(--marigold); border-radius: 14px; padding: 34px 32px 30px; display: flex; flex-direction: column; box-shadow: 0 24px 44px -28px rgba(31,14,39,0.55); }
  .tm__mark { font-family: var(--display); font-weight: 800; font-size: 72px; line-height: 0.6; color: var(--teal); height: 34px; }
  blockquote { margin: 0 0 28px; font-size: 19px; line-height: 1.55; flex: 1; }
  figcaption { display: flex; align-items: center; gap: 14px; font-size: 15px; padding-top: 18px; border-top: 1px solid var(--line); }
  figcaption img, .tm__initials { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; flex: none; }
  .tm__initials { display: flex; align-items: center; justify-content: center; background: var(--marigold); color: var(--aubergine); font-weight: 800; font-family: var(--display); font-size: 18px; }
  figcaption strong { display: block; }
  .tm__role { display: block; color: var(--mauve); }
  @media (max-width: 640px) { .tm { padding-block: 64px; } blockquote { font-size: 17px; } }
</style>
